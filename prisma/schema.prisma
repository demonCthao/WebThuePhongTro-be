generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model amenities {
  id             Int              @id @default(autoincrement()) @db.UnsignedSmallInt
  code           String           @unique(map: "uq_amenities_code") @db.VarChar(50)
  name           String           @db.VarChar(100)
  icon           String?          @db.VarChar(100)
  sort_order     Int              @default(0) @db.SmallInt
  room_amenities room_amenities[]
}

model blog_categories {
  id         Int          @id @default(autoincrement()) @db.UnsignedSmallInt
  name       String       @db.VarChar(100)
  slug       String       @unique(map: "uq_blog_categories_slug") @db.VarChar(100)
  sort_order Int          @default(0) @db.SmallInt
  blog_posts blog_posts[]
}

model blog_post_tags {
  post_id    BigInt     @db.UnsignedBigInt
  tag_id     Int        @db.UnsignedInt
  blog_posts blog_posts @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_bpt_post")
  blog_tags  blog_tags  @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_bpt_tag")

  @@id([post_id, tag_id])
  @@index([tag_id], map: "idx_blog_post_tags_tag")
}

model blog_posts {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  author_id       BigInt            @db.UnsignedBigInt
  category_id     Int?              @db.UnsignedSmallInt
  title           String            @db.VarChar(255)
  slug            String            @unique(map: "uq_blog_posts_slug")
  excerpt         String?           @db.VarChar(500)
  content         String            @db.MediumText
  cover_url       String?           @db.VarChar(500)
  status          blog_posts_status @default(draft)
  published_at    DateTime?         @db.DateTime(0)
  seo_title       String?           @db.VarChar(255)
  seo_description String?           @db.VarChar(500)
  view_count      Int               @default(0)
  search_text     String?           @db.Text
  created_at      DateTime          @default(now()) @db.DateTime(0)
  updated_at      DateTime          @default(now()) @db.DateTime(0)
  deleted_at      DateTime?         @db.DateTime(0)
  blog_post_tags  blog_post_tags[]
  users           users             @relation(fields: [author_id], references: [id], onUpdate: Restrict, map: "fk_blog_author")
  blog_categories blog_categories?  @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_blog_category")

  @@index([category_id], map: "fk_blog_category")
  @@index([author_id], map: "idx_blog_posts_author")
  @@index([status, published_at], map: "idx_blog_posts_list")
  @@fulltext([search_text], map: "ft_blog_posts_search")
}

model blog_tags {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  name           String           @unique(map: "uq_blog_tags_name") @db.VarChar(100)
  slug           String           @unique(map: "uq_blog_tags_slug") @db.VarChar(100)
  blog_post_tags blog_post_tags[]
}

model contact_events {
  id         BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  room_id    BigInt                 @db.UnsignedBigInt
  user_id    BigInt?                @db.UnsignedBigInt
  channel    contact_events_channel
  session_id String?                @db.VarChar(100)
  ip_hash    String?                @db.Char(64)
  user_agent String?                @db.VarChar(255)
  created_at DateTime               @default(now()) @db.DateTime(0)
  rooms      rooms                  @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ce_room")
  users      users?                 @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_ce_user")

  @@index([room_id, created_at], map: "idx_contact_events_room")
  @@index([user_id, created_at], map: "idx_contact_events_user")
}

model permissions {
  id               Int                @id @default(autoincrement()) @db.UnsignedSmallInt
  code             String             @unique(map: "uq_permissions_code") @db.VarChar(100)
  description      String?            @db.VarChar(255)
  role_permissions role_permissions[]
}

model province_aliases {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  province_id  Int       @db.UnsignedSmallInt
  alias_search String    @db.VarChar(100)
  provinces    provinces @relation(fields: [province_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pa_province")

  @@unique([province_id, alias_search], map: "uq_province_alias")
  @@index([alias_search], map: "idx_province_alias_search")
}

model provinces {
  id               Int                @id @default(autoincrement()) @db.UnsignedSmallInt
  code             String             @unique(map: "uq_provinces_code") @db.VarChar(20)
  name             String             @db.VarChar(100)
  full_name        String             @db.VarChar(150)
  slug             String             @unique(map: "uq_provinces_slug") @db.VarChar(100)
  name_search      String             @db.VarChar(100)
  center_lat       Decimal?           @db.Decimal(9, 6)
  center_lng       Decimal?           @db.Decimal(9, 6)
  sort_order       Int                @default(0) @db.SmallInt
  is_active        Boolean            @default(true)
  ads              ads[]
  province_aliases province_aliases[]
  rooms            rooms[]
  wards            wards[]

  @@index([name_search], map: "idx_provinces_name_search")
}

model role_permissions {
  role_id       Int         @db.UnsignedSmallInt
  permission_id Int         @db.UnsignedSmallInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rp_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rp_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_rp_permission")
}

model roles {
  id               Int                @id @default(autoincrement()) @db.UnsignedSmallInt
  code             String             @unique(map: "uq_roles_code") @db.VarChar(50)
  name             String             @db.VarChar(100)
  description      String?            @db.VarChar(255)
  role_permissions role_permissions[]
  user_roles       user_roles[]
}

model room_amenities {
  room_id    BigInt    @db.UnsignedBigInt
  amenity_id Int       @db.UnsignedSmallInt
  amenities  amenities @relation(fields: [amenity_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ra_amenity")
  rooms      rooms     @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ra_room")

  @@id([room_id, amenity_id])
  @@index([amenity_id], map: "idx_room_amenities_amenity")
}

model room_categories {
  id         Int     @id @default(autoincrement()) @db.UnsignedSmallInt
  code       String  @unique(map: "uq_room_categories_code") @db.VarChar(50)
  name       String  @db.VarChar(100)
  slug       String  @unique(map: "uq_room_categories_slug") @db.VarChar(100)
  is_share   Boolean @default(false)
  sort_order Int     @default(0) @db.SmallInt
  is_active  Boolean @default(true)
  rooms      rooms[]
}

model room_likes {
  user_id    BigInt   @db.UnsignedBigInt
  room_id    BigInt   @db.UnsignedBigInt
  created_at DateTime @default(now()) @db.DateTime(0)
  rooms      rooms    @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_likes_room")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_likes_user")

  @@id([user_id, room_id])
  @@index([room_id], map: "idx_room_likes_room")
  @@index([user_id, created_at], map: "idx_room_likes_user_time")
}

model room_media {
  id         BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  room_id    BigInt          @db.UnsignedBigInt
  kind       room_media_kind @default(image)
  url        String          @db.VarChar(500)
  thumb_url  String?         @db.VarChar(500)
  sort_order Int             @default(0) @db.SmallInt
  is_cover   Boolean         @default(false)
  cover_key  Int?            @db.TinyInt
  created_at DateTime        @default(now()) @db.DateTime(0)
  rooms      rooms           @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_media_room")

  @@unique([room_id, cover_key], map: "uq_room_media_cover")
  @@index([room_id, sort_order], map: "idx_room_media_room")
}

model room_moderations {
  id          BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  room_id     BigInt                  @db.UnsignedBigInt
  reviewer_id BigInt?                 @db.UnsignedBigInt
  action      room_moderations_action
  comment     String?                 @db.VarChar(1000)
  created_at  DateTime                @default(now()) @db.DateTime(0)
  users       users?                  @relation(fields: [reviewer_id], references: [id], onUpdate: Restrict, map: "fk_mod_reviewer")
  rooms       rooms                   @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_mod_room")

  @@index([reviewer_id], map: "fk_mod_reviewer")
  @@index([room_id, created_at], map: "idx_moderations_room")
}

model room_reports {
  id                                    BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  room_id                               BigInt              @db.UnsignedBigInt
  reporter_id                           BigInt?             @db.UnsignedBigInt
  reason                                room_reports_reason
  note                                  String?             @db.VarChar(1000)
  status                                room_reports_status @default(open)
  handled_by                            BigInt?             @db.UnsignedBigInt
  handled_at                            DateTime?           @db.DateTime(0)
  created_at                            DateTime            @default(now()) @db.DateTime(0)
  updated_at                            DateTime            @default(now()) @db.DateTime(0)
  users_room_reports_handled_byTousers  users?              @relation("room_reports_handled_byTousers", fields: [handled_by], references: [id], onUpdate: Restrict, map: "fk_rep_handler")
  users_room_reports_reporter_idTousers users?              @relation("room_reports_reporter_idTousers", fields: [reporter_id], references: [id], onUpdate: Restrict, map: "fk_rep_reporter")
  rooms                                 rooms               @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rep_room")

  @@index([handled_by], map: "fk_rep_handler")
  @@index([reporter_id], map: "fk_rep_reporter")
  @@index([room_id], map: "idx_reports_room")
  @@index([status, created_at], map: "idx_reports_status")
}

model room_share_details {
  room_id           BigInt                         @id @db.UnsignedBigInt
  slots_total       Int                            @db.UnsignedSmallInt
  slots_available   Int                            @db.UnsignedSmallInt
  current_occupants Int                            @default(0) @db.UnsignedSmallInt
  price_per_person  BigInt?                        @db.UnsignedBigInt
  gender_pref       room_share_details_gender_pref @default(any)
  note              String?                        @db.VarChar(500)
  rooms             rooms                          @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_share_room")
}

model room_stats {
  room_id       BigInt @id @db.UnsignedBigInt
  view_count    Int    @default(0)
  like_count    Int    @default(0)
  contact_count Int    @default(0)
  rooms         rooms  @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_stats_room")
}

model roommate_requests {
  id           BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  room_id      BigInt                   @db.UnsignedBigInt
  requester_id BigInt                   @db.UnsignedBigInt
  message      String?                  @db.VarChar(1000)
  status       roommate_requests_status @default(pending)
  active_key   Int?                     @db.TinyInt
  responded_at DateTime?                @db.DateTime(0)
  created_at   DateTime                 @default(now()) @db.DateTime(0)
  updated_at   DateTime                 @default(now()) @db.DateTime(0)
  users        users                    @relation(fields: [requester_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rr_requester")
  rooms        rooms                    @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_rr_room")

  @@unique([room_id, requester_id, active_key], map: "uq_roommate_active")
  @@index([requester_id, created_at], map: "idx_roommate_requester")
}

model rooms {
  id                             BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  owner_id                       BigInt                 @db.UnsignedBigInt
  category_id                    Int                    @db.UnsignedSmallInt
  title                          String                 @db.VarChar(255)
  slug                           String                 @unique(map: "uq_rooms_slug")
  description                    String                 @db.Text
  price_monthly                  BigInt                 @db.UnsignedBigInt
  deposit                        BigInt?                @db.UnsignedBigInt
  electricity_price              Int?                   @db.UnsignedInt
  water_price                    Int?                   @db.UnsignedInt
  area_m2                        Decimal                @db.Decimal(7, 2)
  max_people                     Int?                   @db.UnsignedSmallInt
  floor_no                       Int?                   @db.SmallInt
  available_from                 DateTime?              @db.Date
  province_id                    Int                    @db.UnsignedSmallInt
  ward_id                        Int                    @db.UnsignedInt
  street_address                 String                 @db.VarChar(255)
  full_address                   String                 @db.VarChar(500)
  address_source                 rooms_address_source   @default(manual)
  google_place_id                String?                @db.VarChar(255)
  google_formatted_address       String?                @db.VarChar(500)
  geocode_raw                    String?                @db.LongText
  latitude                       Decimal?               @db.Decimal(9, 6)
  longitude                      Decimal?               @db.Decimal(9, 6)
  contact_name                   String                 @db.VarChar(150)
  contact_phone                  String                 @db.VarChar(10)
  zalo_phone                     String?                @db.VarChar(10)
  zalo_url                       String?                @db.VarChar(100)
  status                         rooms_status           @default(draft)
  vip_level                      Int                    @default(0) @db.UnsignedTinyInt
  published_at                   DateTime?              @db.DateTime(0)
  expires_at                     DateTime?              @db.DateTime(0)
  approved_by                    BigInt?                @db.UnsignedBigInt
  approved_at                    DateTime?              @db.DateTime(0)
  rejected_reason                String?                @db.VarChar(500)
  search_text                    String?                @db.Text
  created_at                     DateTime               @default(now()) @db.DateTime(0)
  updated_at                     DateTime               @default(now()) @db.DateTime(0)
  deleted_at                     DateTime?              @db.DateTime(0)
  contact_events                 contact_events[]
  room_amenities                 room_amenities[]
  room_likes                     room_likes[]
  room_media                     room_media[]
  room_moderations               room_moderations[]
  room_reports                   room_reports[]
  room_share_details             room_share_details?
  room_stats                     room_stats?
  roommate_requests              roommate_requests[]
  users_rooms_approved_byTousers users?                 @relation("rooms_approved_byTousers", fields: [approved_by], references: [id], onUpdate: Restrict, map: "fk_rooms_approved_by")
  room_categories                room_categories        @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "fk_rooms_category")
  users_rooms_owner_idTousers    users                  @relation("rooms_owner_idTousers", fields: [owner_id], references: [id], onUpdate: Restrict, map: "fk_rooms_owner")
  provinces                      provinces              @relation(fields: [province_id], references: [id], onUpdate: Restrict, map: "fk_rooms_province")
  wards                          wards                  @relation(fields: [ward_id, province_id], references: [id, province_id], onUpdate: Restrict, map: "fk_rooms_ward")
  viewing_appointments           viewing_appointments[]

  @@index([approved_by], map: "fk_rooms_approved_by")
  @@index([province_id], map: "fk_rooms_province")
  @@index([ward_id, province_id], map: "fk_rooms_ward")
  @@index([category_id], map: "idx_rooms_category")
  @@index([status, expires_at], map: "idx_rooms_expiry")
  @@index([latitude, longitude], map: "idx_rooms_geo")
  @@index([status, province_id, category_id, vip_level, published_at], map: "idx_rooms_listing")
  @@index([owner_id], map: "idx_rooms_owner")
  @@index([google_place_id(length: 191)], map: "idx_rooms_place")
  @@index([status, ward_id, price_monthly], map: "idx_rooms_ward_price")
  @@fulltext([search_text], map: "ft_rooms_search")
}

model user_roles {
  user_id                            BigInt   @db.UnsignedBigInt
  role_id                            Int      @db.UnsignedSmallInt
  granted_by                         BigInt?  @db.UnsignedBigInt
  granted_at                         DateTime @default(now()) @db.DateTime(0)
  users_user_roles_granted_byTousers users?   @relation("user_roles_granted_byTousers", fields: [granted_by], references: [id], onUpdate: Restrict, map: "fk_ur_granted_by")
  roles                              roles    @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "fk_ur_role")
  users_user_roles_user_idTousers    users    @relation("user_roles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ur_user")

  @@id([user_id, role_id])
  @@index([granted_by], map: "fk_ur_granted_by")
  @@index([role_id], map: "idx_user_roles_role")
}

model users {
  id                                                            BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  phone                                                         String                 @unique(map: "uq_users_phone") @db.VarChar(10)
  email                                                         String?                @unique(map: "uq_users_email")
  password_hash                                                 String                 @db.VarChar(255)
  full_name                                                     String                 @db.VarChar(150)
  avatar_url                                                    String?                @db.VarChar(500)
  status                                                        users_status           @default(active)
  phone_verified_at                                             DateTime?              @db.DateTime(0)
  email_verified_at                                             DateTime?              @db.DateTime(0)
  referrer_id                                                   BigInt?                @db.UnsignedBigInt
  last_login_at                                                 DateTime?              @db.DateTime(0)
  created_at                                                    DateTime               @default(now()) @db.DateTime(0)
  updated_at                                                    DateTime               @default(now()) @db.DateTime(0)
  deleted_at                                                    DateTime?              @db.DateTime(0)
  ad_events                                                     ad_events[]
  ads                                                           ads[]
  blog_posts                                                    blog_posts[]
  contact_events                                                contact_events[]
  room_likes                                                    room_likes[]
  room_moderations                                              room_moderations[]
  room_reports_room_reports_handled_byTousers                   room_reports[]         @relation("room_reports_handled_byTousers")
  room_reports_room_reports_reporter_idTousers                  room_reports[]         @relation("room_reports_reporter_idTousers")
  roommate_requests                                             roommate_requests[]
  rooms_rooms_approved_byTousers                                rooms[]                @relation("rooms_approved_byTousers")
  rooms_rooms_owner_idTousers                                   rooms[]                @relation("rooms_owner_idTousers")
  user_roles_user_roles_granted_byTousers                       user_roles[]           @relation("user_roles_granted_byTousers")
  user_roles_user_roles_user_idTousers                          user_roles[]           @relation("user_roles_user_idTousers")
  users                                                         users?                 @relation("usersTousers", fields: [referrer_id], references: [id], onUpdate: Restrict, map: "fk_users_referrer")
  other_users                                                   users[]                @relation("usersTousers")
  viewing_appointments_viewing_appointments_cancelled_byTousers viewing_appointments[] @relation("viewing_appointments_cancelled_byTousers")
  viewing_appointments_viewing_appointments_seeker_idTousers    viewing_appointments[] @relation("viewing_appointments_seeker_idTousers")

  @@index([referrer_id], map: "idx_users_referrer")
}

model viewing_appointments {
  id                                             BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  room_id                                        BigInt                      @db.UnsignedBigInt
  seeker_id                                      BigInt                      @db.UnsignedBigInt
  scheduled_at                                   DateTime                    @db.DateTime(0)
  status                                         viewing_appointments_status @default(pending)
  contact_phone                                  String?                     @db.VarChar(10)
  seeker_note                                    String?                     @db.VarChar(500)
  owner_note                                     String?                     @db.VarChar(500)
  confirmed_at                                   DateTime?                   @db.DateTime(0)
  cancelled_at                                   DateTime?                   @db.DateTime(0)
  cancelled_by                                   BigInt?                     @db.UnsignedBigInt
  cancel_reason                                  String?                     @db.VarChar(500)
  created_at                                     DateTime                    @default(now()) @db.DateTime(0)
  updated_at                                     DateTime                    @default(now()) @db.DateTime(0)
  users_viewing_appointments_cancelled_byTousers users?                      @relation("viewing_appointments_cancelled_byTousers", fields: [cancelled_by], references: [id], onUpdate: Restrict, map: "fk_appt_cancelled")
  rooms                                          rooms                       @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_appt_room")
  users_viewing_appointments_seeker_idTousers    users                       @relation("viewing_appointments_seeker_idTousers", fields: [seeker_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_appt_seeker")

  @@unique([room_id, seeker_id, scheduled_at], map: "uq_appointment")
  @@index([cancelled_by], map: "fk_appt_cancelled")
  @@index([room_id, scheduled_at], map: "idx_appointments_room")
  @@index([seeker_id, scheduled_at], map: "idx_appointments_seeker")
}

model ward_aliases {
  id           Int    @id @default(autoincrement()) @db.UnsignedInt
  ward_id      Int    @db.UnsignedInt
  alias_search String @db.VarChar(100)
  wards        wards  @relation(fields: [ward_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wa_ward")

  @@unique([ward_id, alias_search], map: "uq_ward_alias")
  @@index([alias_search], map: "idx_ward_alias_search")
}

model wards {
  id           Int             @id @default(autoincrement()) @db.UnsignedInt
  province_id  Int             @db.UnsignedSmallInt
  code         String          @unique(map: "uq_wards_code") @db.VarChar(20)
  name         String          @db.VarChar(100)
  full_name    String          @db.VarChar(150)
  ward_type    wards_ward_type
  slug         String          @db.VarChar(100)
  name_search  String          @db.VarChar(100)
  center_lat   Decimal?        @db.Decimal(9, 6)
  center_lng   Decimal?        @db.Decimal(9, 6)
  is_active    Boolean         @default(true)
  merged_into  Int?            @db.UnsignedInt
  rooms        rooms[]
  ward_aliases ward_aliases[]
  wards        wards?          @relation("wardsTowards", fields: [merged_into], references: [id], onUpdate: Restrict, map: "fk_wards_merged")
  other_wards  wards[]         @relation("wardsTowards")
  provinces    provinces       @relation(fields: [province_id], references: [id], onUpdate: Restrict, map: "fk_wards_province")

  @@unique([id, province_id], map: "uq_wards_id_province")
  @@unique([province_id, slug], map: "uq_wards_province_slug")
  @@index([merged_into], map: "fk_wards_merged")
  @@index([province_id, name_search], map: "idx_wards_name_search")
}

model ad_events {
  id         BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  ad_id      BigInt               @db.UnsignedBigInt
  user_id    BigInt?              @db.UnsignedBigInt
  event_type ad_events_event_type
  session_id String?              @db.VarChar(100)
  ip_hash    String?              @db.Char(64)
  user_agent String?              @db.VarChar(255)
  referrer   String?              @db.VarChar(500)
  created_at DateTime             @default(now()) @db.DateTime(0)
  ads        ads                  @relation(fields: [ad_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ad_events_ad")
  users      users?               @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_ad_events_user")

  @@index([ad_id, event_type, created_at], map: "idx_ad_events_ad")
  @@index([user_id, created_at], map: "idx_ad_events_user")
}

model ad_placements {
  id          Int     @id @default(autoincrement()) @db.UnsignedSmallInt
  code        String  @unique(map: "uq_ad_placements_code") @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)
  width_px    Int?    @db.UnsignedSmallInt
  height_px   Int?    @db.UnsignedSmallInt
  max_ads     Int     @default(1) @db.UnsignedTinyInt
  is_active   Boolean @default(true)
  ads         ads[]
}

model ad_stats {
  ad_id            BigInt @id @db.UnsignedBigInt
  impression_count Int    @default(0)
  click_count      Int    @default(0)
  ads              ads    @relation(fields: [ad_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ad_stats_ad")
}

model ads {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  placement_id     Int           @db.UnsignedSmallInt
  title            String        @db.VarChar(150)
  image_url        String        @db.VarChar(500)
  image_mobile_url String?       @db.VarChar(500)
  alt_text         String?       @db.VarChar(255)
  link_url         String        @db.VarChar(1000)
  open_new_tab     Boolean       @default(true)
  advertiser_name  String?       @db.VarChar(150)
  advertiser_phone String?       @db.VarChar(10)
  note             String?       @db.VarChar(500)
  status           ads_status    @default(draft)
  starts_at        DateTime?     @db.DateTime(0)
  ends_at          DateTime?     @db.DateTime(0)
  province_id      Int?          @db.UnsignedSmallInt
  sort_order       Int           @default(0) @db.SmallInt
  weight           Int           @default(1) @db.UnsignedTinyInt
  created_by       BigInt?       @db.UnsignedBigInt
  created_at       DateTime      @default(now()) @db.DateTime(0)
  updated_at       DateTime      @default(now()) @db.DateTime(0)
  deleted_at       DateTime?     @db.DateTime(0)
  ad_events        ad_events[]
  ad_stats         ad_stats?
  users            users?        @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "fk_ads_creator")
  ad_placements    ad_placements @relation(fields: [placement_id], references: [id], onUpdate: Restrict, map: "fk_ads_placement")
  provinces        provinces?    @relation(fields: [province_id], references: [id], onUpdate: Restrict, map: "fk_ads_province")

  @@index([created_by], map: "idx_ads_creator")
  @@index([province_id], map: "idx_ads_province")
  @@index([placement_id, status, starts_at, ends_at, sort_order], map: "idx_ads_serve")
}

